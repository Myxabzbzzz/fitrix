# Copy to backend/.env and adjust: `cp .env.example .env`.
# `npm start` reads .env automatically; real environment variables win.
# .env is git-ignored — never commit real secrets.

# --- Server -----------------------------------------------------------
PORT=3000

# --- Ollama -----------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# true re-enables reasoning (~10x slower replies)
OLLAMA_THINK=false
# keep the model loaded between messages
OLLAMA_KEEP_ALIVE=30m

# --- Auth (Supabase) --------------------------------------------------
# With SUPABASE_URL set, /chat, /chat/stream and /chat/reset require
# `Authorization: Bearer <Supabase access token>` (verified with the
# project's public keys from <SUPABASE_URL>/auth/v1/.well-known/jwks.json).
#
# Local stack (`supabase start`). Use 127.0.0.1, not localhost: the token's
# issuer must match <SUPABASE_URL>/auth/v1 exactly.
SUPABASE_URL=http://127.0.0.1:55321
# Cloud project instead:
# SUPABASE_URL=https://<project-ref>.supabase.co

# Only for projects still signing tokens with the legacy JWT secret (HS256):
# Dashboard → Project Settings → JWT Keys → Legacy JWT secret.
# Leave empty for asymmetric signing keys (the local stack and new projects).
SUPABASE_JWT_SECRET=

# Only if the `iss` claim differs from <SUPABASE_URL>/auth/v1 (custom domain,
# backend reaching Supabase through another address).
# SUPABASE_JWT_ISSUER=https://auth.example.com/auth/v1

# "off" disables auth for local hacking: anyone who can reach the server can
# use the model. Default: required whenever SUPABASE_URL/SUPABASE_JWT_SECRET
# is set, off otherwise. "required" refuses to start without Supabase config.
# AUTH_MODE=off

# Chat requests per user per minute before 429 Too Many Requests (0 = off).
RATE_LIMIT_PER_MINUTE=20
