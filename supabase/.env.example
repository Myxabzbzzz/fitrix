# Copy to supabase/.env (git-ignored), fill in, then restart the local stack:
#   supabase stop && supabase start
# Leave a provider's lines commented out to keep it disabled.
# See README.md, "Google and Apple sign-in".

# Google: accept ID tokens whose audience is one of these OAuth client ids
# (Google Cloud Console > APIs & Services > Credentials), web client first.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=true
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<web client id>,<iOS client id>
# Optional, not used by the app's sign-in (only by browser redirects):
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<web client secret>

# Apple (needs a paid Apple Developer account): the app's bundle id.
# SUPABASE_AUTH_EXTERNAL_APPLE_ENABLED=true
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.elibayev.fitrix
